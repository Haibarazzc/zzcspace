{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog/",
      "destination": "/portfolio/blog/",
      "permanent": true
    },
    {
      "source": "/blog/:path*/",
      "destination": "/portfolio/blog/:path*/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/portfolio/blog/:path*",
      "permanent": true
    },
    {
      "source": "/map/",
      "destination": "/portfolio/map/",
      "permanent": true
    },
    {
      "source": "/map/:path*",
      "destination": "/portfolio/map/:path*",
      "permanent": true
    }
  ]
}
